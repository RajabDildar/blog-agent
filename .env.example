GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=your_google_ai_studio_key

GROQ_WRITER_MODEL=openai/gpt-oss-120b
GROQ_REVISION_MODEL=openai/gpt-oss-120b

GEMINI_MODEL=gemini-3.1-flash-lite
EVAL_JUDGE_MODEL=gemini-3.1-flash-lite
EVAL_MAX_RATE_LIMIT_WAIT_SECONDS=120
EVAL_BETWEEN_RUN_DELAY_SECONDS=5
EVAL_RESUME_ATTEMPT_LIMIT=3

TAVILY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

LANGGRAPH_STRICT_MSGPACK=true
CHECKPOINT_SQLITE_PATH=runs/checkpoints.sqlite

RATE_LIMIT_SHORT_WAIT_SECONDS=10

GROQ_MAX_CONCURRENT_GENERATIONS=2
GROQ_TOKEN_BUDGET_PER_MINUTE=8000
GROQ_TOKEN_BUDGET_SAFETY_MARGIN=0.25
GROQ_TOKEN_RESERVATION_PER_GENERATION=1500
